    "axes[1].set_xlabel(\"Mã Khách hàng (CUSTOMER_ID)\")\n",
    "axes[1].set_ylabel(\"Số trạm POS khác nhau (unique_pos_count)\")\n",
    "axes[1].tick_params(axis='x', rotation=45)\n",

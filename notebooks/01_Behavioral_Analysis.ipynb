      "=== DANH SÁCH KHÁCH HÀNG CÓ GIAO DỊCH ĐỘT BIẾN BAN ĐÊM TẠI NHIỀU TRẠM POS ===\n",
      "+-----------+--------------------+----------------+----------------+-----------------+--------------------+\n",
      "|CUSTOMER_ID|night_spike_tx_count|unique_pos_count|max_spike_amount|normal_avg_amount|fraud_cases_detected|\n",

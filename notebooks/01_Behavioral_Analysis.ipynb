      "|       1847|                   5|               5|          439.25|             64.6|                   5|\n",
      "|       6357|                   5|               5|          511.15|            60.02|                   5|\n",
      "|       4467|                   5|               5|          898.15|            99.54|                   5|\n",
      "|        220|                   5|               5|           603.1|            65.26|                   5|\n",

    "\n",
    "# Biểu đồ 3: So sánh Giá trị Đột biến Ban đêm vs Mức trung bình bình thường\n",
    "top_amount_spickers = pdf_night_spikes.sort_values(by=\"max_spike_amount\", ascending=False).head(8)\n",
